generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  role         UserRole      @default(AGENT)
  createdAt    DateTime      @default(now())
  appointments Appointment[]
}

model Appointment {
  id           String            @id @default(cuid())
  companyName  String
  contactName  String
  email        String
  phone        String?
  date         DateTime
  time         String
  status       AppointmentStatus @default(PENDING)
  notes        String?
  assignedTo   String?
  assignedUser User?             @relation(fields: [assignedTo], references: [id])
  files        AppointmentFile[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

model AppointmentFile {
  id            String      @id @default(cuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  filename      String
  originalName  String
  size          Int
  createdAt     DateTime    @default(now())
}

model Lead {
  id          String     @id @default(cuid())
  companyName String
  contactName String
  email       String
  phone       String?
  website     String?
  industry    String
  source      LeadSource @default(MANUAL)
  status      LeadStatus @default(NEW)
  notes       String?
  proposals   Proposal[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Proposal {
  id          String         @id @default(cuid())
  companyName String
  contactName String
  email       String
  phone       String?
  leadId      String?
  lead        Lead?          @relation(fields: [leadId], references: [id])
  status      ProposalStatus @default(DRAFT)
  value       Float?
  notes       String?
  files       ProposalFile[]
  sentAt      DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model ProposalFile {
  id           String   @id @default(cuid())
  proposalId   String
  proposal     Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  filename     String
  originalName String
  size         Int
  createdAt    DateTime @default(now())
}

model ProspectSearch {
  id          String   @id @default(cuid())
  industry    String
  location    String
  companySize String?
  keywords    String?
  createdAt   DateTime @default(now())
}

enum UserRole {
  ADMIN
  AGENT
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  DONE
  CANCELLED
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  DISCARDED
  CONVERTED
}

enum LeadSource {
  MANUAL
  GOOGLE_PLACES
  LINKEDIN
  APOLLO
  CLAY
  CLEARBIT
  SERPAPI
  REFERRAL
  WEBSITE
  OTHER
}

enum ProposalStatus {
  DRAFT
  SENT
  NEGOTIATING
  ACCEPTED
  REJECTED
}
